# Server-only Supabase configuration (never prefix with NEXT_PUBLIC_)
SUPABASE_URL="https://dtirpilgzlsfryucanlg.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
SUPABASE_SECRET_KEY="your-server-secret-key"

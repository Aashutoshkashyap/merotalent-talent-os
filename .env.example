# Public browser configuration
NEXT_PUBLIC_SUPABASE_PROJECT_ID="dtirpilgzlsfryucanlg"
NEXT_PUBLIC_SUPABASE_URL="https://dtirpilgzlsfryucanlg.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Server-only Supabase configuration (never prefix with NEXT_PUBLIC_)
SUPABASE_URL="https://dtirpilgzlsfryucanlg.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
SUPABASE_SECRET_KEY="your-server-secret-key"
SUPABASE_JWKS_URL="https://dtirpilgzlsfryucanlg.supabase.co/auth/v1/.well-known/jwks.json"

# AES-256-GCM key for encrypting provider secrets (eSewa, AI, Email) stored in DB.
# Generate with: python3 -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Must be exactly 32 bytes encoded as canonical base64 (44 characters ending with =).
# KEEP THIS SECRET — losing it makes all stored provider secrets permanently unrecoverable.
PROVIDER_CONFIG_ENCRYPTION_KEY="generate-a-32-byte-base64-key"

# Optional server/operator import of the reference ePay V2 configuration.
# Never prefix these with NEXT_PUBLIC_. No production defaults are assumed.
# Provider Center remains the encrypted runtime source of truth; entering/importing
# credentials must not enable production payment initiation automatically.
# The isolated bootstrap accepts only UAT and never writes production.
# ESEWA_ENVIRONMENT="uat" # Reference "sandbox" is normalized to "uat".
# ESEWA_MERCHANT_CODE=""
# ESEWA_SECRET_KEY=""
# Legacy ESEWA_MERCHANT_ID is accepted only when it agrees with MERCHANT_CODE.
# ESEWA_BASE_URL is optional and must match the selected official gateway.

# Exact allowlisted production destination for administrator invitations.
# Server validation requires HTTPS, no query/fragment/credentials/port, and
# the exact /reset-password path. Never derive this value from request Host.
NEXT_PUBLIC_SITE_URL="https://www.merotalent.com"
AUTH_INVITE_REDIRECT_URL="https://www.merotalent.com/reset-password"

# Vercel Cron sends this value as Authorization: Bearer <CRON_SECRET>
CRON_SECRET="generate-a-long-random-secret"

# Isolated Neon staging email delivery is off by default. Enabling delivery
# also requires exact comma-separated test recipients (maximum 20) and queued
# notification metadata.delivery_environment = "neon-staging". Copied source
# notifications are never eligible. Provider Center must hold enabled Resend
# credentials encrypted with the server-only key above.
NEON_STAGING_EMAIL_DELIVERY_ENABLED="false"
NEON_STAGING_EMAIL_TEST_RECIPIENTS=""
# Production is independently opt-in. Only production-origin queue records created
# on/after the explicitly chosen UTC cutover instant are eligible. Never backdate
# this cutoff to replay copied source/staging messages. Requires enabled Resend.
NEON_PRODUCTION_EMAIL_DELIVERY_ENABLED="false"
# Only enable new paid checkout after genuine server-verified gateway acceptance.
NEON_PRODUCTION_PAYMENTS_ENABLED="false"
NEON_PRODUCTION_EMAIL_NOT_BEFORE=""
# Official Managed Auth OAuth adapter; never a local Better Auth database.
# Keep disabled until trusted origins and the branch's Google provider are verified.
NEON_GOOGLE_OAUTH_ENABLED="false"
NEON_AUTH_COOKIE_SECRET=""
# A separate, exact E.164 allowlist controls isolated OpenWA verification.
NEON_STAGING_WHATSAPP_VERIFICATION_ENABLED="false"
NEON_STAGING_WHATSAPP_TEST_RECIPIENTS=""

# Optional CLI/migration connections. Use real values only in a secret manager.
DATABASE_URL=""
DIRECT_URL=""
